\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{skeleton-notes}[2026/09/02 Shared skeleton notes formatting]

\RequirePackage[top=0.4in,bottom=0.75in,left=1in,right=1in]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{array}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{hyperref}
\RequirePackage{enumitem}
\RequirePackage{tikz}
\RequirePackage{framed}
\usetikzlibrary{arrows.meta,calc,decorations.pathmorphing,positioning}
\pagestyle{empty}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.35em}
\setlist{nosep,leftmargin=2em}
\tikzset{
  note axis/.style={->,thin},
  note curve/.style={thick,smooth},
  note dashed/.style={densely dashed,thin},
  open point/.style={circle,draw,fill=white,inner sep=2pt},
  closed point/.style={circle,draw,fill=black,inner sep=1.7pt}
}

\makeatletter
\renewcommand{\maketitle}{%
  \setcounter{example}{0}%
  \noindent{\centering\bfseries\normalsize\@title\par}%
  \vspace{0.1em}}
\makeatother

\newcommand{\blank}[1]{\rule{#1}{0.4pt}}
\newcommand{\ds}{\displaystyle}

\newif\ifshowsolutions
\showsolutionstrue
\newsavebox{\solutionbox}
\newcommand{\sol}[1]{%
  \setbox\solutionbox=\vbox{\hsize=\linewidth #1}%
  \ifshowsolutions
    \unvbox\solutionbox
  \else
    \par\noindent\rule{0pt}{\dimexpr\ht\solutionbox+\dp\solutionbox\relax}\par
  \fi}

\newcommand{\sectionlabel}[1]{\par\medskip\noindent\textbf{#1}\par\smallskip}
\newcommand{\goals}[1]{\noindent\textbf{Goals:} #1\par\vspace{-\parskip}}
\newcommand{\beforeclassvideos}[1]{\noindent\textbf{Before Class Videos:} #1\par\vspace{-\parskip}}
\newcommand{\afterclassproblems}[1]{%
  \par\medskip\noindent\textbf{Suggested after class problems} \href{https://opentext.uleth.ca/apex-calculus/apex-calculus.html}{from APEX:} #1\par\smallskip}

\newcounter{example}
\newcommand{\Example}{%
  \refstepcounter{example}%
  \noindent\textbf{Example \theexample:}\ }

\newcommand{\Definition}[1]{%
  \par\medskip\noindent\fbox{\parbox{0.94\linewidth}{%
    \textbf{Definition:}\par\smallskip#1}}
  \par\medskip}

\newcommand{\Theorem}[1]{%
  \par\medskip\noindent\fbox{\parbox{0.94\linewidth}{%
    \textbf{Theorem:}\par\smallskip#1}}
  \par\medskip}

\newenvironment{theorembox}
  {\par\medskip\begin{framed}\textbf{Theorem:}\par\smallskip}
  {\end{framed}\par\medskip}

\newcommand{\Activity}{\par\medskip\noindent\textbf{Activity:}\ }
\newcommand{\BigIdea}{\par\medskip\noindent\textbf{Big Idea:}\ }
\newcommand{\BonusExample}{\par\medskip\noindent\textbf{Bonus Example:}\ }
\newcommand{\SourceAnnotation}[1]{\textcolor{red}{#1}}

\newcommand{\DNE}{\mathrm{DNE}}
